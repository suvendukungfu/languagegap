# ==============================================================================
# LanguageGap Environment Configuration Template
# Copy this file to .env before starting services: cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Service Configuration
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./languagegap.db
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# Gemma Model Provider Configuration
# ------------------------------------------------------------------------------
# Supported providers:
#   - "mock"   : Offline deterministic fixtures (zero API cost / CI testing)
#   - "gemma"  : Live OpenAI-compatible endpoints (Google AI Studio, Ollama, vLLM)
#   - "openai" : Alias for OpenAI-compatible endpoint
GEMMA_PROVIDER=mock

# --- Topology 1: Google AI Studio (Gemini / Gemma OpenAI-compatible endpoint) ---
# GEMMA_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# GEMMA_API_KEY=your_google_ai_studio_api_key_here
# GEMMA_MODEL_ID=gemini-2.0-flash   # Or "gemma-2-27b-it", "gemma-2-9b-it"

# --- Topology 2: Local Ollama (Gemma 4 / Gemma 2) ---
# GEMMA_BASE_URL=http://localhost:11434/v1
# GEMMA_API_KEY=
# GEMMA_MODEL_ID=gemma-4-it

# --- Topology 3: Local vLLM Inference Server ---
# GEMMA_BASE_URL=http://localhost:8000/v1
# GEMMA_API_KEY=EMPTY
# GEMMA_MODEL_ID=google/gemma-4-it

# Default fallback settings
GEMMA_BASE_URL=http://localhost:11434/v1
GEMMA_API_KEY=
GEMMA_MODEL_ID=gemma-4-it
SAMPLING_TEMPERATURE=0.2
SAMPLING_TOP_P=0.95
MAX_GENERATION_TOKENS=1024

# ------------------------------------------------------------------------------
# Evaluation Engine Settings
# ------------------------------------------------------------------------------
EVALUATION_TIMEOUT_SECONDS=60
MAX_RETRIES=3
BENCHMARK_VERSION=1.0.0

# ------------------------------------------------------------------------------
# Frontend Application Configuration
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
