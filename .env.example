# ==============================================================================
# LanguageGap Environment Configuration Template
# Copy this file to .env before starting services: cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Service Configuration
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./languagegap.db
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# Gemma Model Provider Configuration
# ------------------------------------------------------------------------------
# Supported providers: "mock" (offline testing/demo), "openai" (OpenAI-compatible endpoints: vLLM, Ollama, etc.)
GEMMA_PROVIDER=mock
GEMMA_BASE_URL=http://localhost:11434/v1
GEMMA_API_KEY=
GEMMA_MODEL_ID=gemma-4-it
SAMPLING_TEMPERATURE=0.2
SAMPLING_TOP_P=0.95
MAX_GENERATION_TOKENS=1024

# ------------------------------------------------------------------------------
# Evaluation Engine Settings
# ------------------------------------------------------------------------------
EVALUATION_TIMEOUT_SECONDS=60
MAX_RETRIES=3
BENCHMARK_VERSION=1.0.0

# ------------------------------------------------------------------------------
# Frontend Application Configuration
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
